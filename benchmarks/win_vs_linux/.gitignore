# Run output — regenerated by run_benchmark.{ps1,sh} on every run (hundreds of MB
# of State/DSMCState files). Only the parsed CSVs under results/ are tracked.
results/run_*/
logs/
driver_full.log

# Measured data — re-included against the repo-root `*.csv` rule. This is the
# benchmark's actual result; RESULTS.md / LINUX_RESULTS.md are derived from it.
!results/win_timings.csv
!results/linux_timings.csv

# Frozen benchmark inputs: re-include the .h5 files that the repo-root .gitignore
# excludes. These MUST stay committed — Windows and Linux have to solve a
# byte-identical problem, so the mesh and BGField are shipped, never regenerated.
!pic_hempt_hdg/HEMPT_90deg_BGField.h5
!pic_hempt_hdg/pre-hopr/90_deg_segment_mesh.h5
!dsmc_periodic3d/pre-hopr/periodic_mesh.h5

# Re-run CSVs (2026-07-29 repeatability session) are tracked alongside the baseline.
!results/win_timings_rerun_o1.csv
!results/win_timings_rerun_o3.csv
